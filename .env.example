# PostgreSQL (e.g. Neon, Supabase, local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/letsconnect?sslmode=require

# MongoDB Atlas — chat message history
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=letsconnect

JWT_SECRET=change-me-to-a-long-random-string
# Optional. Leave empty to derive from JWT_SECRET. If set, must be a valid Fernet key:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

GMAIL_CREDENTIALS_PATH=./credentials.json

# Slack — create app at https://api.slack.com/apps
# OAuth redirect: {BACKEND_URL}/slack/oauth/callback
# Event Subscriptions URL: {BACKEND_URL}/slack/events (use ngrok for local dev)
# Bot events: message.im, app_mention
# User Token Scopes (OAuth & Permissions): chat:write, im:write, users:read,
#   channels:history, channels:read, groups:history, groups:read
# App Home: enable Messages Tab (+ allow user messages) and optional Home tab
# Subscribe to app_home_opened under Event Subscriptions
# Set SLACK_APP_ID to your App ID (Basic Information) for "Open in Slack" links
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Email — OTP for signup + password reset
# Recommended: Brevo (free 300 emails/day, sends to ANY address) https://www.brevo.com
# 1. Sign up → Settings → SMTP & API → create API key
# 2. Senders → verify gauravdewli@easemyhiring.ai (click link in inbox)
# 3. Set BREVO_API_KEY and EMAIL_FROM below
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM=LetsConnect <gauravdewli@easemyhiring.ai>

# Alternative: Resend (needs verified domain to email everyone)
# RESEND_API_KEY=re_...
# EMAIL_FROM=LetsConnect <onboarding@resend.dev>

# Alternative: any SMTP (e.g. Brevo SMTP relay smtp-relay.brevo.com:587)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=gauravdewli@easemyhiring.ai
# SMTP_PASSWORD=your-brevo-smtp-key

# Jira — OAuth 2.0 (3LO) app: https://developer.atlassian.com/console/myapps
# 1. Create → OAuth 2.0 integration → name LetsConnect
# 2. Permissions → Jira API: read:jira-work, write:jira-work, read:jira-user, offline_access
# 3. Authorization → callback: {BACKEND_URL}/jira/oauth/callback
# 4. Settings → copy Client ID + Secret below, restart backend
# Optional: override callback if BACKEND_URL differs from Atlassian registration
# JIRA_OAUTH_CALLBACK_URI=http://localhost:8000/jira/oauth/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
