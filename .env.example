# PostgreSQL (e.g. Neon, Supabase, local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/letsconnect?sslmode=require

JWT_SECRET=change-me-to-a-long-random-string
# Optional. Leave empty to derive from JWT_SECRET. If set, must be a valid Fernet key:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

GMAIL_CREDENTIALS_PATH=./credentials.json

# Slack — create app at https://api.slack.com/apps
# OAuth redirect: {BACKEND_URL}/slack/oauth/callback
# Event Subscriptions URL: {BACKEND_URL}/slack/events (use ngrok for local dev)
# Bot events: message.im, app_mention
# User Token Scopes (OAuth & Permissions): chat:write, im:write, users:read,
#   channels:history, channels:read, groups:history, groups:read
# App Home: enable Messages Tab (+ allow user messages) and optional Home tab
# Subscribe to app_home_opened under Event Subscriptions
# Set SLACK_APP_ID to your App ID (Basic Information) for "Open in Slack" links
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
